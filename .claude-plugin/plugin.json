{
  "name": "indiigo-rm2",
  "displayName": "indiigo reMarkable",
  "version": "0.3.0",
  "description": "indiigo reMarkable: check the connection, list documents and view pages of a reMarkable 2 from Claude on macOS, over USB or Wi-Fi. Never changes the tablet. Unofficial, not affiliated with reMarkable AS.",
  "author": {
    "name": "indiigo",
    "email": "roy@indiigo.com"
  },
  "repository": "https://github.com/indiigo-consulting/indiigo-claude-rm2-plugin",
  "license": "MIT",
  "privacyPolicyUrl": "https://github.com/indiigo-consulting/indiigo-claude-rm2-plugin/blob/main/PRIVACY.md",
  "mcpServers": {
    "remarkable": {
      "command": "/usr/bin/osascript",
      "args": [
        "-l",
        "JavaScript",
        "${CLAUDE_PLUGIN_ROOT}/server.js"
      ]
    }
  },
  "keywords": [
    "remarkable",
    "remarkable-2",
    "notes",
    "handwriting",
    "macos"
  ]
}
